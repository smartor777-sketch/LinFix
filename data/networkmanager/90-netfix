#!/bin/sh
# NetFix: NetworkManager dispatcher (M4).
# Работает в минимальном окружении: только абсолютные пути, лог в journald.
set -eu

[ "${2:-}" = "up" ] || exit 0

logger -t netfix "network up: ${CONNECTION_UUID:-unknown} (${CONNECTION_ID:-unknown})"

# Включить в M4:
# /usr/libexec/netfix-helper profile.apply "${CONNECTION_UUID:-}" >/dev/null 2>&1 || true

exit 0
